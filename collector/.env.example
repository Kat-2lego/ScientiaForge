# Copy to collector/.env and fill in. NEVER commit the real file.
# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role (legacy JWT) or sb_secret_... key. Backend/collector only — never in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional
NSC_STORAGE_BUCKET=past-papers
# seconds between requests to education.gov.za (be polite)
NSC_REQUEST_DELAY=1.5
