+/* =========================================================
+   SKILL CATEGORY HELPER (shared with signup logic)
+========================================================= */
+
+const SOFT_SKILLS = [
+  "communication",
+  "stakeholder management",
+  "leadership",
+  "teamwork",
+  "problem solving",
+  "negotiation",
+  "conflict resolution",
+  "resource planning",
+];
+
+function categorizeSkill(normalizedName) {
+  return SOFT_SKILLS.includes(normalizedName) ? "Soft Skill" : "Technical";
+}
+
+/* =========================================================
