seimport express from "express";
import cors from "cors";
import { createClient } from "@supabase/supabase-js";
import Groq from "groq-sdk";
import dotenv from "dotenv";
import path from "path";
import { fileURLToPath } from "url";
import WebSocket from "ws";

// ─────────────────────────────────────────────────────────────────
// CUSTOM TTS — bypasses @andresaya/edge-tts entirely.
// The library's synthesize() resolves on WebSocket 'close', but Node's
// event loop can process the 'close' callback before the final 'message'
// callbacks, so audio_stream is empty when toBuffer() is called.
// This implementation resolves only after "Path:turn.end" is received
// inside a message — guaranteeing all audio chunks have already arrived.
// ─────────────────────────────────────────────────────────────────

const TRUSTED_CLIENT_TOKEN = "6A5AA1D4EAFF4E9FB37E23D68491D6F4";
const WSS_URL = "wss://speech.platform.bing.com/consumer/speech/synthesize/readaloud/edge/v1";
const VERSION_MS_GEC = "1-143.0.3650";

function generateUUID() {
  return "xxxxxxxx-xxxx-xxxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === "x" ? r : (r & 0x3) | 0x8).toString(16);
  });
}

async function generateSecMsGec() {
  const now = new Date();
  const ticks = Math.floor(now.getTime() / 1000) + 11644473600;
  const rounded = ticks - (ticks % 300);
  const windowsTicks = rounded * 10_000_000;
  const encoder = new TextEncoder();
  const data = encoder.encode(`${windowsTicks}${TRUSTED_CLIENT_TOKEN}`);
  const hashBuffer = await crypto.subtle.digest("SHA-256", data);
  return Array.from(new Uint8Array(hashBuffer))
    .map((b) => b.toString(16).padStart(2, "0"))
    .join("")
    .toUpperCase();
}

function escapeXML(text) {
  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&apos;");
}

function buildSSML(text, voice) {
  return `<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="en-US">
    <voice name="${voice}">
      <prosody pitch="+0Hz" rate="+0%" volume="+0%">
        ${escapeXML(text)}
      </prosody>
    </voice>
  </speak>`;
}

/**
 * Synthesise text to MP3 audio using the Edge TTS WebSocket API.
 * Resolves with a Buffer when "Path:turn.end" is received in a message —
 * this guarantees every audio chunk has already been pushed before we resolve.
 */
function synthesizeTTS(text, voice) {
  return new Promise(async (resolve, reject) => {
    const chunks = [];
    const reqId  = generateUUID();
    const secMsGEC = await generateSecMsGec().catch(reject);
    if (!secMsGEC) return;

    const url = `${WSS_URL}?TrustedClientToken=${TRUSTED_CLIENT_TOKEN}` +
                `&Sec-MS-GEC=${secMsGEC}&Sec-MS-GEC-Version=${VERSION_MS_GEC}` +
                `&ConnectionId=${reqId}`;

    const ws = new WebSocket(url, {
      headers: {
        "User-Agent":     "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 Safari/537.36 Edg/143.0.0.0",
        "Accept-Language": "en-US,en;q=0.9",
        "Origin":         "chrome-extension://jdiccldimpdaibmpdkjnbmckianbfold",
      },
      rejectUnauthorized: false,
    });

    const timeout = setTimeout(() => {
      ws.terminate();
      reject(new Error("Edge TTS WebSocket timed out after 30s"));
    }, 30_000);

    ws.on("open", () => {
      // 1. Send speech config
      const ts = new Date().toUTCString();
      ws.send(
        `X-Timestamp:${ts}\r\nContent-Type:application/json; charset=utf-8\r\nPath:speech.config\r\n\r\n` +
        `{"context":{"synthesis":{"audio":{"metadataoptions":{"sentenceBoundaryEnabled":false,"wordBoundaryEnabled":false},"outputFormat":"audio-24khz-48kbitrate-mono-mp3"}}}}`
      );
      // 2. Send SSML
      ws.send(
        `X-RequestId:${reqId}\r\nContent-Type:application/ssml+xml\r\nX-Timestamp:${ts}\r\nPath:ssml\r\n\r\n` +
        buildSSML(text, voice)
      );
    });

    ws.on("message", (data) => {
      // data is a Buffer for binary frames, string for text frames
      const buf = Buffer.isBuffer(data) ? data : Buffer.from(data);
      const str = buf.toString("utf8");

      // Audio chunk — binary frame with "Path:audio\r\n" header
      const AUDIO_NEEDLE = Buffer.from("Path:audio\r\n");
      const audioIdx = buf.indexOf(AUDIO_NEEDLE);
      if (audioIdx !== -1) {
        chunks.push(buf.subarray(audioIdx + AUDIO_NEEDLE.length));
        return;
      }

      // turn.end — all audio has been delivered; resolve now
      if (str.includes("Path:turn.end")) {
        clearTimeout(timeout);
        ws.close();
        if (chunks.length === 0) {
          reject(new Error("Edge TTS: turn.end received but no audio chunks collected"));
        } else {
          resolve(Buffer.concat(chunks));
        }
      }
    });

    ws.on("error", (err) => {
      clearTimeout(timeout);
      reject(err);
    });

    // 'close' fires after 'message', so this is only a safety net for
    // cases where turn.end was somehow missed.
    ws.on("close", () => {
      clearTimeout(timeout);
      if (chunks.length > 0) {
        resolve(Buffer.concat(chunks));
      }
      // If already resolved/rejected via message handler, these are no-ops.
    });
  });
}

// Resolve .env relative to this file (server/server.mjs → ../.env = project root)
// This works regardless of which directory you run `node` from.
dotenv.config({ path: new URL("../.env", import.meta.url).pathname });

console.log("SUPABASE_URL:", process.env.SUPABASE_URL);
console.log("SUPABASE_ANON_KEY:", process.env.SUPABASE_ANON_KEY);
console.log("PORT:", process.env.PORT);

if (!process.env.SUPABASE_URL || !process.env.SUPABASE_ANON_KEY) {
  console.error("❌ Missing SUPABASE_URL or SUPABASE_ANON_KEY in .env");
  process.exit(1);
}

const app = express();
const PORT = process.env.PORT || 5001;

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const CLIENT_PATH = path.join(__dirname, "..", "client");

console.log("Serving static files from:", CLIENT_PATH);

// --- Supabase ---
const supabase = createClient(
  process.env.SUPABASE_URL,
  process.env.SUPABASE_ANON_KEY
);

// --- Groq ---
const groq = new Groq({ apiKey: process.env.GROQ_API_KEY });

// ─────────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────────

async function callGroq(prompt, retries = 3) {
  for (let i = 0; i < retries; i++) {
    try {
      const response = await groq.chat.completions.create({
        model: "llama-3.1-8b-instant",
        messages: [{ role: "user", content: prompt }],
        temperature: 0.7,
        max_tokens: 1024,
      });
      return response.choices[0].message.content.trim();
    } catch (err) {
      if (i === retries - 1) throw err;
      console.warn(`Groq attempt ${i + 1} failed, retrying...`);
      await new Promise((r) => setTimeout(r, 1000));
    }
  }
}

/**
 * BUG 1 FIX: Robustly extract the first JSON array from a raw Groq string.
 * Old approach used regex requiring a closing `]` which fails on truncated responses.
 * New approach: find `[`, try to parse, then repair by slicing to last `}` and appending `]`.
 */
function extractJsonArray(raw) {
  if (typeof raw !== "string") return null;

  const stripped = raw.replace(/```(?:json)?/gi, "").trim();

  // Find the opening bracket
  const startIdx = stripped.indexOf("[");
  if (startIdx === -1) return null;

  let candidate = stripped.slice(startIdx);

  // If already valid, parse immediately
  try {
    return JSON.parse(candidate);
  } catch (_) {
    /* fall through to repair */
  }

  // Find the last complete object — ends with }
  const lastBrace = candidate.lastIndexOf("}");
  if (lastBrace === -1) return null;

  // Trim everything after the last } and close the array
  candidate = candidate.slice(0, lastBrace + 1) + "\n]";

  try {
    return JSON.parse(candidate);
  } catch (e) {
    console.warn("Failed to parse repaired JSON array:", candidate.slice(0, 300));
    return null;
  }
}

/**
 * Robustly extract the first JSON object from a raw Groq string.
 */
function extractJsonObject(raw) {
  const stripped = raw.replace(/```(?:json)?/gi, "").trim();
  const match = stripped.match(/\{[\s\S]*\}/);
  if (!match) return null;

  let candidate = match[0];
  if (!candidate.endsWith("}")) {
    candidate = candidate + " }";
  }

  try {
    return JSON.parse(candidate);
  } catch {
    return null;
  }
}

// --- Middleware ---
app.use(cors());
app.use(express.json());
app.use(express.static(CLIENT_PATH));

app.get("/", (req, res) => {
  res.redirect("/pages/LogIn.html");
});

// ─────────────────────────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────────────────────────

app.post("/api/auth/login", async (req, res) => {
  const { email, password } = req.body;
  if (!email || !password)
    return res.status(400).json({ error: "Email and password are required." });

  try {
    const { data, error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) return res.status(401).json({ error: error.message });
    res.json({ success: true, user: { id: data.user.id, email: data.user.email } });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

app.post("/api/auth/signup", async (req, res) => {
  const { email, password, firstNames } = req.body;
  if (!email || !password || !firstNames)
    return res.status(400).json({ error: "All fields required." });

  try {
    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: {
        data: {
          first_name: firstNames.split(" ")[0],
          last_name: firstNames.split(" ").slice(1).join(" ") || " ",
        },
      },
    });
    if (error) throw error;
    res.json({ success: true, user: { id: data.user?.id } });
  } catch (err) {
    console.error("❌ Signup Error:", err.message);
    res.status(500).json({ error: err.message });
  }
});

// ─────────────────────────────────────────────────────────────────
// EDGE TTS PROXY
// ─────────────────────────────────────────────────────────────────

const PERSONA_VOICES = {
  "senior-engineer": "en-US-DavisNeural",
  "hr-manager":      "en-US-JennyNeural",
  "product-manager": "en-US-GuyNeural",
  "consultant":      "en-US-AriaNeural",
};

const DEFAULT_VOICE = "en-US-JennyNeural";

app.post("/api/tts", async (req, res) => {
  const { text, personaId } = req.body;

  if (!text) {
    return res.status(400).json({ error: "Text is required" });
  }

  const voiceName = PERSONA_VOICES[personaId] || DEFAULT_VOICE;

  try {
    console.log(`🎤 Generating speech | persona: ${personaId || "default"} | voice: ${voiceName}`);
    console.log(`📝 Text length: ${text.length} characters`);

    const audioBuffer = await synthesizeTTS(text, voiceName);

    res.setHeader("Content-Type", "audio/mpeg");
    res.setHeader("Content-Length", audioBuffer.length);
    res.send(audioBuffer);

    console.log(`✅ Speech generated successfully (${audioBuffer.length} bytes)`);
  } catch (err) {
    console.error("❌ Edge-TTS Error:", err.message);
    console.error("Stack trace:", err.stack);
    res.status(500).json({ error: "Failed to generate speech: " + err.message });
  }
});

